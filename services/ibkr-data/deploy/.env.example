# Copy to .env and fill in. .env is gitignored and must stay that way.
TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password

# live or paper. A read-only username on a live account wants: live
TRADING_MODE=live

# Belt and braces. The username is already read-only at IBKR; this makes the
# API refuse orders too.
READ_ONLY_API=yes

# The gateway restarts itself daily. Pick a time outside US market hours.
AUTO_RESTART_TIME=11:59 PM
TIME_ZONE=Africa/Johannesburg

# VNC password, only needed to eyeball the login screen on port 5901.
VNC_SERVER_PASSWORD=
